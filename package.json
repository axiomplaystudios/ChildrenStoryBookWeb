{
  "name": "bedtime-bookshelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/catalog.mjs && vite --host 0.0.0.0",
    "build": "node scripts/catalog.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm test && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "vite": "8.3.7",
    "vite-plugin-pwa": "2.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "page-flip": "2.0.7"
  }
}
