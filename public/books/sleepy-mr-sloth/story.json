  "questions": [
    {
      "type": "literal",
      "q": "What did Mr Sloth want to do?",
      "a": "Sleep! He wanted a good branch for a bed.",
      "hintPage": 1
    },
    {
      "type": "literal",
      "q": "Who made a loud squawking noise?",
      "a": "The bird. It was too noisy for Mr Sloth to sleep there.",
      "hintPage": 10
    },
    {
      "type": "feeling",
      "q": "How did the animals feel at the end?",
      "a": "Happy to have Mr Sloth in their tree. Other feelings your child notices are welcome, too.",
      "hintPage": 12
    },
    {
      "type": "personal",
      "q": "Where do you like to sleep?",
      "a": "There is no wrong answer. Listen, then invite your child to tell you more.",
      "hintPage": 11
    }
  ]
}
